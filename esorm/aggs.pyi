class ESAggBucket(Dict[str, Any]):
    """
    A bucket of a bucket aggregation response

    The key is a string, a number, or a dict (composite aggregation). The results of the sub-aggregations can be
    accessed by their names: ``bucket['avg_age']['value']``.
    """

    @overload
    def __getitem__(self, key: _BucketKey) -> Any:
        ...

    @overload
    def __getitem__(self, key: _BucketStrKey) -> str:
        ...

    @overload
    def __getitem__(self, key: _BucketIntKey) -> int:
        ...

    @overload
    def __getitem__(self, key: _BucketFloatKey) -> float:
        ...

    @overload
    def __getitem__(self, key: str) -> ESAggResult:
        ...

class ESAggResult(Dict[str, Any]):
    """
    The result of an aggregation

    The keys depend on the type of the aggregation: e.g. ``value`` for avg, sum, min, max, cardinality,
    ``buckets`` for terms, histogram, range, ``doc_count`` for filter, nested, missing. The results of the
    sub-aggregations of single bucket aggregations (e.g. filter, nested) can be accessed by their names.

    The ``value`` of avg, min, max is None if there are no documents.
    """

    @overload
    def __getitem__(self, key: _ResultOptionalFloatKey) -> Optional[float]:
        ...

    @overload
    def __getitem__(self, key: _ResultFloatKey) -> float:
        ...

    @overload
    def __getitem__(self, key: _ResultStrKey) -> str:
        ...

    @overload
    def __getitem__(self, key: _ResultIntKey) -> int:
        ...

    @overload
    def __getitem__(self, key: _ResultBucketsKey) -> List[ESAggBucket]:
        ...

    @overload
    def __getitem__(self, key: _ResultValuesKey) -> Dict[str, Optional[float]]:
        ...

    @overload
    def __getitem__(self, key: _ResultDictKey) -> Dict[str, Any]:
        ...

    @overload
    def __getitem__(self, key: _ResultListKey) -> List[Dict[str, Any]]:
        ...

    @overload
    def __getitem__(self, key: str) -> ESAggResult:
        ...
